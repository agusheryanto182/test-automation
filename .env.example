# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://app:app@localhost:5432/app

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Mailpit (SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=notifications@example.com

# Worker
LOG_LEVEL=info
